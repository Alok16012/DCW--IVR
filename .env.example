# ---------------------------------------------------------------------------
# DCW-IVR — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string, used only by scripts/apply-migration.ts
# (Project Settings → Database → Connection string / URI, include the password)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# Telephony provider: "mock" (default, works with no external account),
# "exotel", "buzzdial" or "myoperator" (each needs a live account + creds below)
TELEPHONY_PROVIDER=mock

# Exotel — leave blank until the client's Exotel account + KYC is provisioned
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# Buzzdial — auth key from portal (My Account → My Profile → Authkey)
BUZZDIAL_AUTH_KEY=
# API base, override only if Buzzdial gives you a different host
BUZZDIAL_BASE_URL=https://buzzdial.io
# Shared secret we require on incoming trigger webhooks. Add it in the portal
# (Trigger → API Trigger → Parameter setup) as an extra param named "token".
BUZZDIAL_WEBHOOK_SECRET=
# Rented DID number for call masking (optional; from your account manager)
BUZZDIAL_DID_NUMBER=
# Buzzdial's API Trigger has no recording parameter, so recordings can only be
# reached by URL pattern. Copy a recording link from the portal's Reports page
# and replace the call id with {call_id}, e.g.
# https://buzzdial.io/recordings/{call_id}.mp3
BUZZDIAL_RECORDING_URL_TEMPLATE=

# MyOperator — panel → APIs & Webhooks → Developer API → Calling APIs
MYOPERATOR_COMPANY_ID=
MYOPERATOR_API_KEY=
# "Authentication" field on the Calling APIs page (this is the real secret)
MYOPERATOR_SECRET_TOKEN=
# Panel → Call → Outgoing → Campaigns: create a peer-to-peer campaign to get it
MYOPERATOR_PUBLIC_IVR_ID=
# Token for developers.myoperator.co — enables agent lookup (User Dialer) and
# recording links. Without it, calls fall back to the Anonymous Dialer.
MYOPERATOR_SEARCH_TOKEN=
# Shared secret we require on incoming webhooks. Configure it in the panel as an
# API-Key auth header named "x-webhook-token" on the v2 webhook.
MYOPERATOR_WEBHOOK_SECRET=

# DCW CRM — every call is pushed here as a lead (source "IVR"), assigned to the
# counsellor whose CRM name matches the IVR agent who took it. Leave both blank
# to turn the sync off; the IVR works exactly as before without them.
CRM_LEAD_WEBHOOK_URL=https://your-crm-domain/api/leads/ivr
# Must be identical to IVR_WEBHOOK_SECRET in the CRM's environment.
CRM_LEAD_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret shared with Vercel Cron to authorize maintenance jobs
# (retry-webhooks, retention). Generate a long random string.
CRON_SECRET=change-me-to-a-long-random-string
